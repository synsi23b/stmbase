<!DOCTYPE CrossStudio_Project_File>
<solution Name="{project}" target="8" version="2">
  <configuration
    LIBRARY_IO_TYPE="RTT"
    Name="Common"
    arm_compiler_variant="SEGGER"
    arm_linker_heap_size="{heap_size}"
    c_preprocessor_definitions=""
    c_user_include_directories="."
    gcc_cplusplus_language_standard="gnu++20" />
  <configuration
    Name="Debug"
    c_preprocessor_definitions="DEBUG;OS_LIBMODE_DP"
    gcc_debugging_level="Level 3"
    gcc_optimization_level="None" />
  <configuration
    Name="Release"
    c_preprocessor_definitions="NDEBUG;OS_LIBMODE_R"
    gcc_debugging_level="None"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="Level 3" />
  <configuration
    Name="Release Profiling"
    c_preprocessor_definitions="NDEBUG;OS_LIBMODE_SP"
    gcc_debugging_level="None"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="Level 3" />
  <project Name="{project}">
    <configuration
      LIBRARY_HEAP_TYPE="Basic"
      LIBRARY_IO_TYPE="RTT"
      Name="Common"
      arm_architecture="v7EM"
      arm_core_type="Cortex-M4"
      arm_endian="Little"
      arm_fp_abi="Hard"
      arm_fpu_type="FPv4-SP-D16"
      arm_compiler_variant="SEGGER"
      arm_linker_process_stack_size="0"
      arm_linker_stack_size="1024"
      arm_linker_variant="SEGGER"
      arm_rtl_variant="SEGGER"
      arm_simulator_memory_simulation_parameter="ROM;0x08000000;0x00020000;RAM;0x10000000;0x00002800;RAM;0x20000000;0x00004000;RAM;0x20004000;0x00001800"
      arm_target_debug_interface_type="ADIv5"
      arm_target_device_name="STM32G431KB"
      arm_target_interface_type="SWD"
      build_intermediate_directory="$(ProjectDir)/Output/$(Configuration)"
      build_output_directory="$(ProjectDir)/Output/$(Configuration)"
      c_additional_options="-Wall;-Wextra;-Wunused-variable;-Wuninitialized;-Wmissing-field-initializers;-Wundef;-ffunction-sections;-fdata-sections"
      c_only_additional_options=""
      c_preprocessor_definitions="__VTOR_CONFIG;ARM_MATH_CM4;STM32G431xx;__STM32G431_SUBFAMILY;__STM32G4XX_FAMILY;SYSVIEW_DEVICE_NAME=&quot;STM32G431&quot;;SYSVIEW_RAM_BASE=0x20000000;USE_RTT=1;__VFP_HARD__"
      c_user_include_directories="$(ProjectDir)/stmbase/embos/common;$(ProjectDir)/stmbase/embos/stm32g431kbu3;$(ProjectDir)/stmbase/synhal32;$(ProjectDir)/stmbase/CANopenNode;$(ProjectDir)/stmbase/cube_can;$(ProjectDir)/src"
      debug_register_definition_file="$(ProjectDir)/stmbase/embos/stm32g431kbu3/STM32G431xx_Registers.xml"
      debug_target_connection="J-Link"
      debug_threads_script="$(ProjectDir)/stmbase/embos/embOSPluginSES.js"
      gcc_entry_point="Reset_Handler"
      link_linker_script_file="$(ProjectDir)/stmbase/embos/stm32g431kbu3/STM32G4xx_Flash.icf"
      linker_additional_options="--gc-sections"
      linker_additional_system_libraries=""
      linker_memory_map_file="$(ProjectDir)/stmbase/embos/stm32g431kbu3/STM32G431KBUx_MemoryMap.xml"
      linker_output_format="hex"
      project_directory=""
      project_type="Executable"
      target_reset_script="Reset();"
      target_script_file="$(ProjectDir)/stmbase/embos/stm32g431kbu3/STM32G4xx_Target.js" />
    <folder Name="src" exclude="" filter="" path="src" recurse="No" />
    <folder
      Name="synhal"
      exclude=""
      filter=""
      path="stmbase/synhal32"
      recurse="No">
      <configuration Name="Debug" gcc_optimization_level="None" />
      <configuration
        Name="Common"
        gcc_optimization_level="Level 2 balanced" />
    </folder>
    <folder
      Name="canopen_node"
      exclude="example;CO_config.h"
      filter=""
      path="stmbase/CANopenNode"
      recurse="Yes">
      <configuration
        Name="Common"
        gcc_optimization_level="Level 2 balanced" />
      <configuration Name="Debug" gcc_optimization_level="Level 2 balanced" />
    </folder>
    <folder Name="sys_SEGGER">
      <configuration Name="Debug" gcc_optimization_level="Level 3" />
      <folder Name="Lib">
        <file file_name="$(ProjectDir)/stmbase/embos/lib/libos_v7m_t_vfpv4h_le_dp.a">
          <configuration Name="Release" build_exclude_from_build="Yes" />
          <configuration
            Name="Release Profiling"
            build_exclude_from_build="Yes" />
        </file>
        <file file_name="$(ProjectDir)/stmbase/embos/lib/libos_v7m_t_vfpv4h_le_r.a">
          <configuration Name="Debug" build_exclude_from_build="Yes" />
          <configuration
            Name="Release Profiling"
            build_exclude_from_build="Yes" />
        </file>
        <file file_name="$(ProjectDir)/stmbase/embos/lib/libos_v7m_t_vfpv4h_le_sp.a">
          <configuration Name="Debug" build_exclude_from_build="Yes" />
          <configuration Name="Release" build_exclude_from_build="Yes" />
        </file>
      </folder>
      <file file_name="$(ProjectDir)/stmbase/embos/common/HardFaultHandler.S" />
      <file file_name="$(ProjectDir)/stmbase/embos/common/JLINKMEM_Process.c">
        <configuration Name="Release" build_exclude_from_build="No" />
      </file>
      <file file_name="$(ProjectDir)/stmbase/embos/common/OS_Error.c">
        <configuration Name="Release" build_exclude_from_build="Yes" />
      </file>
      <file file_name="$(ProjectDir)/stmbase/embos/common/OS_ThreadSafe.c" />
      <file file_name="stmbase/embos/common/RTOS.h" />
      <file file_name="$(ProjectDir)/stmbase/embos/common/SEGGER_HardFaultHandler.c" />
      <file file_name="$(ProjectDir)/stmbase/embos/common/SEGGER_RTT.c" />
      <file file_name="$(ProjectDir)/stmbase/embos/common/SEGGER_RTT_ASM_ARMv7M.S">
        <configuration Name="Release" build_exclude_from_build="Yes" />
      </file>
      <file file_name="$(ProjectDir)/stmbase/embos/common/SEGGER_SYSVIEW.c">
        <configuration Name="Release" build_exclude_from_build="Yes" />
      </file>
      <file file_name="$(ProjectDir)/stmbase/embos/common/SEGGER_SYSVIEW_Config_embOS.c">
        <configuration Name="Release" build_exclude_from_build="Yes" />
      </file>
      <file file_name="$(ProjectDir)/stmbase/embos/common/SEGGER_SYSVIEW_embOS_Ultra.c">
        <configuration Name="Release" build_exclude_from_build="Yes" />
      </file>
    </folder>
    <folder Name="sys_Setup">
      <file file_name="$(ProjectDir)/stmbase/embos/stm32g431kbu3/RTOSInit_STM32G4xx.c" />
      <file file_name="stmbase/embos/stm32g431kbu3/SEGGER_THUMB_Startup.s" />
      <file file_name="$(ProjectDir)/stmbase/embos/stm32g431kbu3/stm32g431xx_Vectors.s" />
      <file file_name="$(ProjectDir)/stmbase/embos/stm32g431kbu3/STM32G4xx_Flash.icf" />
      <file file_name="$(ProjectDir)/stmbase/embos/stm32g431kbu3/STM32G4xx_Startup.s" />
      <file file_name="$(ProjectDir)/stmbase/embos/stm32g431kbu3/system_stm32g4xx.c" />
    </folder>
  </project>
</solution>
